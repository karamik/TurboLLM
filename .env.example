# ================================================================
# TurboLLM Environment Variables Template
# Copy this file to .env and adjust values as needed
# ================================================================

# -------------------- Model & Inference --------------------
# Path to the model inside the container (mounted volume)
MODEL_PATH=/app/model

# Quantization type: "fp8" or leave empty for FP16
QUANTIZATION=fp8

# KV-cache dtype: "fp8" (recommended) or "auto"
KV_CACHE_DTYPE=fp8

# Maximum context length (in tokens)
MAX_MODEL_LEN=32768

# GPU memory utilization (0.0-1.0)
GPU_MEMORY_UTILIZATION=0.90

# Maximum number of sequences in a batch
MAX_NUM_SEQS=256

# Maximum number of batched tokens
MAX_NUM_BATCHED_TOKENS=8192

# -------------------- API Server --------------------
# Host and port for the inference API
HOST=0.0.0.0
PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# -------------------- Hugging Face --------------------
# (Optional) API token for private/gated models
HF_TOKEN=

# -------------------- Redis (caching) --------------------
# Redis connection string for prompt caching (enterprise module)
REDIS_URL=redis://cache:6379

# -------------------- Security (enterprise) --------------------
# JWT secret for authentication
JWT_SECRET=change_this_in_production

# Admin API keys (comma separated for multiple keys)
ADMIN_API_KEYS=admin_key_1,admin_key_2

# Data filtering rules (regex patterns, JSON file path)
FILTER_RULES_PATH=/app/configs/filter_rules.json

# -------------------- Monitoring --------------------
# Enable Prometheus metrics endpoint (true/false)
ENABLE_METRICS=true

# Prometheus multiprocess directory (for gunicorn)
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# -------------------- Advanced vLLM --------------------
# Use chunked prefill (recommended for long contexts)
ENABLE_CHUNKED_PREFILL=true

# Use prefix caching (experimental)
ENABLE_PREFIX_CACHING=false

# Trust remote code (for custom models)
TRUST_REMOTE_CODE=true

# -------------------- Performance Tuning --------------------
# Number of GPU blocks (usually auto-detected)
# BLOCK_SIZE=16

# Scheduler delay factor (0-1)
# SCHEDULER_DELAY_FACTOR=0.1
