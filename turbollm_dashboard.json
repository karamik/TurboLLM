        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 4 },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
